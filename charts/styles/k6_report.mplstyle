font.family: DejaVu Sans
font.size: 10.5

figure.facecolor: white
savefig.facecolor: white
savefig.bbox: tight

axes.facecolor: white
axes.edgecolor: #c9c8c3
axes.linewidth: 0.8
axes.grid: True
axes.labelcolor: #52514e
axes.titleweight: bold
axes.titlesize: 11.5

grid.color: #e6e5e1
grid.linewidth: 0.8

xtick.color: #52514e
ytick.color: #52514e

text.color: #111111

svg.fonttype: none
