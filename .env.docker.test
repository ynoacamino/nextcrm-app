# =============================================================
# Docker Performance Test Environment
# =============================================================
# Basado en .env.test pero con URLs apuntando a servicios Docker
# =============================================================

# Database (usa nombre del servicio Docker: postgres)
DATABASE_URL="postgresql://nextcrm:nextcrm_dev@postgres:5432/nextcrm"
DB_HOST=postgres
DB_PORT=5432
DB_USER=nextcrm
DB_PASSWORD=nextcrm_dev
DB_NAME=nextcrm

# Better Auth
BETTER_AUTH_SECRET="dev-secret-do-not-use-in-production"
BETTER_AUTH_URL="http://localhost:3001"

DOTENV_CONFIG_QUIET=true

# Google OAuth (optional)
GOOGLE_ID=""
GOOGLE_SECRET=""

# Email Service (optional)
RESEND_API_KEY=""

# AI (optional)
OPENAI_API_KEY=""

# Firecrawl (optional)
FIRECRAWL_API_KEY=""

# E2B (optional)
E2B_API_KEY=""

# MinIO (usa nombre del servicio Docker: minio)
NEXT_PUBLIC_MINIO_ENDPOINT="http://minio:9000"
MINIO_ENDPOINT="http://minio:9000"
MINIO_PORT="9000"
MINIO_BUCKET="nextcrm"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="nextcrm"
MINIO_SECRET_KEY="minio_dev_password"

# Inngest (usa nombre del servicio Docker: inngest)
INNGEST_DEV="1"
INNGEST_ID="nextcrm"
INNGEST_APP_NAME="NextCRM"
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY=""
INNGEST_BASE_URL="http://inngest:8288"

# App
NEXT_PUBLIC_APP_NAME="NextCRM"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Dev admin email
TEST_USER_EMAIL="admin@example.com"

# Cron secret
CRON_SECRET="dev-cron-secret"

# Email encryption
EMAIL_ENCRYPTION_KEY="dev-email-encryption-key-64-chars-long-here-1234567890abcdef"

# Resend (optional)
RESEND_WEBHOOK_SECRET=""
RESEND_FROM_EMAIL=""

# Email from address
EMAIL_FROM="no-reply@nextcrm.test"

# Testing environment flag
IS_TESTING="true"

# Server port
PORT=3001

NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=9vVHuyzc05Pl88JCILWjODP6yS4qhv5+YJUIqP8vhHY=

# Performance test specific
PERF_SUITE=smoke
DURATION_SCALE=1

# CRM fixtures for performance tests
INTEGRATION_FIXTURES="true"
PERF_SEED="true"
PERF_SEED_COUNT=100
